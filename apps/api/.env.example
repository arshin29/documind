# Server Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=api

# CORS Configuration
FRONTEND_URL=http://localhost:3000

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/documind?schema=public"

# JWT Authentication Configuration
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=7d

# ----------------------------------------------------
# AI Provider Selection (Keep Embedding and LLM Independent)
# Options: 'gemini' (Free-tier available) | 'openai'
# ----------------------------------------------------
EMBEDDING_PROVIDER=gemini
LLM_PROVIDER=gemini

# ----------------------------------------------------
# Google Gemini Configuration (Free Tier via Google AI Studio)
# Currently Supported Models:
# - Embeddings: gemini-embedding-001 (or gemini-embedding-2; 768 dimensions, free tier)
# - Chat / RAG: gemini-3.5-flash-lite (fast inference, free tier)
# ----------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
# Optional independent key overrides (default to GEMINI_API_KEY)
# GEMINI_EMBEDDING_API_KEY=
# GEMINI_CHAT_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
EMBEDDING_BATCH_SIZE=25
EMBEDDING_MAX_RETRIES=3
EMBEDDING_RETRY_DELAY_MS=1000
EMBEDDING_TIMEOUT_MS=30000
LLM_MAX_RETRIES=3
LLM_RETRY_DELAY_MS=1000
LLM_TIMEOUT_MS=60000

# ----------------------------------------------------
# OpenAI Configuration (Optional / Paid Credits Required)
# ----------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
# Optional independent key overrides (default to OPENAI_API_KEY)
# OPENAI_EMBEDDING_API_KEY=
# OPENAI_CHAT_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=768
OPENAI_CHAT_MODEL=gpt-4o-mini

